APP_NAME=luna-pages
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8082
HTTP_ADDR=:8082
LOG_LEVEL=debug
# Swagger UI at /docs and /internal/docs (the documents are always served).
API_DOCS=true

# Behind nginx: the networks nginx connects from (CIDRs, addresses, "private", "loopback").
# HTTP_TRUSTED_PROXIES=172.18.0.0/16

DB_DRIVER=postgres
DATABASE_DSN=postgres://pages_service:pages_password@127.0.0.1:5433/pages_db?sslmode=require
# Run pending migrations at start (handy locally; use `go run . migrate` in production).
DB_MIGRATE=true

# The dashboard checks API keys: its internal address and this service's token
# (one of the dashboard's LUNA_SERVICE_TOKENS). The same token guards the
# dashboard's calls to /internal/.
LUNA_DASHBOARD_URL=http://localhost:8080
LUNA_DASHBOARD_TOKEN=
