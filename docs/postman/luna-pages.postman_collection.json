            ],
            "url": {
              "raw": "{{baseUrl}}/v1/render?slug=/products/{{entryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "render"
              ],
              "query": [
                {
                  "key": "slug",
                  "value": "/products/{{entryId}}"
