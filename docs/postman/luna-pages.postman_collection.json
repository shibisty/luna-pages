{
  "info": {
    "_postman_id": "89b226c9-0fac-5017-8d4d-b3ad86e6412e",
    "name": "Luna Pages API",
    "description": "The editor contract of luna-pages (docs/openapi.yaml). Set `apiKey` to a server key with `pages:write`. Run in order: every run creates its own layout, template, page and entry and deletes them at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Editor",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ping"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"app\", () => pm.expect(pm.response.json().app_id).to.be.a(\"string\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh ids for this run (the editor makes UUIDs).",
                  "pm.environment.set(\"layoutId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"templateId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"pageId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"entryId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "The site",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/site",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "site"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"siteVersion\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Change the site",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "If-Match",
                "value": "\"{{siteVersion}}\""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/site",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "site"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman shop\",\n  \"settings\": {\n    \"lang\": \"en\"\n  },\n  \"data\": {\n    \"styles\": \"body{font-family:sans-serif}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"name\", () => pm.expect(pm.response.json().name).to.eql(\"Postman shop\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a layout",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/layouts/{{layoutId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "layouts",
                "{{layoutId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman layout {{layoutId}}\",\n  \"data\": {\n    \"pages\": []\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a template",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "templates",
                "{{templateId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Product {{templateId}}\",\n  \"fields\": [\n    {\n      \"name\": \"title\",\n      \"type\": \"text\",\n      \"required\": true\n    },\n    {\n      \"name\": \"price\",\n      \"type\": \"number\",\n      \"format\": \"0.00\"\n    }\n  ],\n  \"data\": {\n    \"pages\": []\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"fields\", () => pm.expect(pm.response.json().fields).to.have.length(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a page (v1 body)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{pageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{pageId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{pageId}}\",\n  \"name\": \"Postman page {{pageId}}\",\n  \"data\": {\n    \"pages\": [\n      {\n        \"component\": \"<h1>Hello</h1>\"\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"slug from the name\", () => pm.expect(pm.response.json().slug).to.match(/^\\/postman-page/));",
                  "pm.environment.set(\"pageVersion\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Change it with If-Match",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "If-Match",
                "value": "\"{{pageVersion}}\""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{pageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{pageId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman page\",\n  \"layout_id\": \"{{layoutId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"version moved\", () => pm.expect(pm.response.json().version).to.eql(pm.environment.get(\"pageVersion\") + 1));"
                ]
              }
            }
          ]
        },
        {
          "name": "A stale write is refused",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "If-Match",
                "value": "\"{{pageVersion}}\""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{pageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{pageId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stale\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 412\", () => pm.response.to.have.status(412));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an entry",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{entryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{entryId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee grinder\",\n  \"slug\": \"/products/{{entryId}}\",\n  \"template_id\": \"{{templateId}}\",\n  \"values\": {\n    \"field.title\": \"Coffee grinder\",\n    \"field.price\": 129.5\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"entry\", () => pm.expect(pm.response.json().page_kind).to.eql(\"entry\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the entry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{entryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{entryId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"values\", () => pm.expect(pm.response.json().values[\"field.price\"]).to.eql(129.5));",
                  "pm.test(\"etag\", () => pm.expect(pm.response.headers.get(\"ETag\")).to.eql('\"1\"'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List pages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"items\", () => pm.expect(pm.response.json().items.length).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "A template in use cannot go",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "templates",
                "{{templateId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the entry",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{entryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{entryId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the page",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{pageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{pageId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the template",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "templates",
                "{{templateId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the layout",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/layouts/{{layoutId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "layouts",
                "{{layoutId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}