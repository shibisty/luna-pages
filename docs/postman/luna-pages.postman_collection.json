          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"items\", () => pm.expect(pm.response.json().items.length).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish the layout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/layouts/{{layoutId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "layouts",
                "{{layoutId}}",
                "publish"
              ]
            },
            "description": "A layout needs a <luna-slot>; the HTML and CSS are sanitized.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"html\": \"<header>Postman shop</header><main><luna-slot></luna-slot></main>\",\n  \"css\": \"header{font-weight:bold}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"revision 1\", () => pm.expect(pm.response.json().revision).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish the template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/templates/{{templateId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "templates",
                "{{templateId}}",
                "publish"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"html\": \"<article><h1 data-field=\\\"title\\\">Name</h1><p>Price: <span data-field=\\\"price\\\">0.00</span></p><script>alert(1)</script></article>\",\n  \"css\": \"article{padding:1rem}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no warnings\", () => pm.expect(pm.response.json().warnings).to.have.length(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish the entry",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/editor/pages/{{entryId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "editor",
                "pages",
                "{{entryId}}",
                "publish"
              ]
            },
            "description": "An entry sends no body: its draft values are checked against the template and go live."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"published\", () => pm.expect(pm.response.json().record.status).to.eql(\"published\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Render the entry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/render?slug=/products/{{entryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "render"
              ],
              "query": [
                {
                  "key": "slug",
                  "value": "/products/{{entryId}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"filled, in the layout\", () => { pm.expect(page.html).to.include(\"<header>Postman shop</header>\"); pm.expect(page.html).to.include(\"129.50\"); });",
                  "pm.test(\"sanitized\", () => pm.expect(page.html).to.not.include(\"<script>\"));",
                  "pm.test(\"css in order\", () => pm.expect(page.css).to.eql(\"header{font-weight:bold}\\narticle{padding:1rem}\"));",
                  "pm.environment.set(\"renderTag\", pm.response.headers.get(\"ETag\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Not modified",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{renderTag}}"
